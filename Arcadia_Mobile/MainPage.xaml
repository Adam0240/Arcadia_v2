<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Arcadia_Mobile.MainPage"
             Title="Arcadia">

    <Grid RowDefinitions="*,Auto"
          Padding="18"
          RowSpacing="16">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="240">
                    <Image Source="{Binding RoomImageSource}"
                           Aspect="AspectFill"
                           SemanticProperties.Description="{Binding RoomName}" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding RoomName}"
                           FontSize="30"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding RoomDescription}"
                           FontSize="17"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <Border Padding="14"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#212121}">
                    <Label Text="{Binding StatusMessage}"
                           FontSize="15"
                           LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="*,*,*"
              RowSpacing="8"
              ColumnSpacing="8">
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Text="North"
                    Command="{Binding MoveNorthCommand}"
                    IsEnabled="{Binding CanMoveNorth}" />
            <Button Grid.Row="1"
                    Grid.Column="0"
                    Text="West"
                    Command="{Binding MoveWestCommand}"
                    IsEnabled="{Binding CanMoveWest}" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Text="Inspect"
                    Command="{Binding InteractCommand}" />
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Text="East"
                    Command="{Binding MoveEastCommand}"
                    IsEnabled="{Binding CanMoveEast}" />
            <Button Grid.Row="2"
                    Grid.Column="1"
                    Text="South"
                    Command="{Binding MoveSouthCommand}"
                    IsEnabled="{Binding CanMoveSouth}" />
        </Grid>
    </Grid>
</ContentPage>
