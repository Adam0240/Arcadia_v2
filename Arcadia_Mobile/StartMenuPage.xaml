<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Arcadia_Mobile.StartMenuPage"
             Title="Arcadia">

    <Grid Padding="28"
          RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1"
                             Spacing="28"
                             VerticalOptions="Center">
            <Label Text="Arcadia"
                   FontSize="42"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Checking save data..."
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding IsCheckingSaveState}" />

            <Button Text="New Game"
                    FontSize="18"
                    Command="{Binding NewGameCommand}"
                    IsVisible="{Binding HasNoSave}"
                    HorizontalOptions="Fill" />

            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding HasSave}">
                <Button Text="Load Game"
                        FontSize="18"
                        Command="{Binding LoadGameCommand}"
                        HorizontalOptions="Fill" />
                <Button Text="Delete Game"
                        FontSize="18"
                        Command="{Binding DeleteGameCommand}"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
